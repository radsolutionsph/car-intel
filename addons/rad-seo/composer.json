{
    "name": "radsolutions/rad-seo",
    "description": "RAD SEO addon for Statamic projects.",
    "type": "statamic-addon",
    "require": {
        "php": "^8.2",
        "spatie/schema-org": "^3.23",
        "statamic/cms": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "RadSolutions\\RadSeo\\": "src"
        }
    },
    "extra": {
        "statamic": {
            "name": "RAD SEO",
            "description": "SEO helpers for RAD Solutions websites."
        },
        "laravel": {
            "providers": [
                "RadSolutions\\RadSeo\\ServiceProvider"
            ]
        }
    }
}
